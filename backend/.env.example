# Copie ce fichier en ".env" et adapte les valeurs

PORT=4000

# Secret utilisé pour signer les tokens JWT. Change-le en production.
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Provider IA pour le Coach : "local" (gratuit, par defaut), "ollama" (IA locale
# auto-hebergee, gratuite, voir OLLAMA_BASE_URL/OLLAMA_MODEL ci-dessous) ou
# "anthropic" (payant, optionnel plus tard)
AI_PROVIDER=local

# Necessaire uniquement si AI_PROVIDER=ollama (installe Ollama sur cette
# machine : https://ollama.com/download, puis `ollama pull llama3.2`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Necessaire uniquement si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Provider de recherche web pour le futur onglet Recherche : "local" (pas
# d'accès Internet, par défaut) ou "brave" (nécessite une clé API, palier
# gratuit disponible sur https://brave.com/search/api/)
SEARCH_PROVIDER=local
SEARCH_API_KEY=

# Email du tout premier compte cree automatiquement en tant qu'administrateur
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
