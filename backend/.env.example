# Copie ce fichier en ".env" et adapte les valeurs

PORT=4000

# Secret utilisé pour signer les tokens JWT. Change-le en production.
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Provider IA pour le Coach : "local" (gratuit, par defaut), "ollama" (IA locale
# auto-hebergee, gratuite, voir OLLAMA_BASE_URL/OLLAMA_MODEL ci-dessous) ou
# "anthropic" (payant, optionnel plus tard)
AI_PROVIDER=local

# Necessaire uniquement si AI_PROVIDER=ollama (installe Ollama sur cette
# machine : https://ollama.com/download, puis `ollama pull llama3.2`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Necessaire uniquement si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Provider de recherche web pour le futur onglet Recherche : "local" (pas
# d'accès Internet, par défaut) ou "brave" (nécessite une clé API, palier
# gratuit disponible sur https://brave.com/search/api/)
SEARCH_PROVIDER=local
SEARCH_API_KEY=

# Provider de reconnaissance automatique sur les photos de repas (Alimentation) :
# "local" (aucune reconnaissance, par defaut) ou "gemini" (gratuit, cle sur
# https://aistudio.google.com/apikey) ou "anthropic" (payant a l'usage, reutilise
# ANTHROPIC_API_KEY ci-dessus si deja renseignee)
VISION_PROVIDER=local
GEMINI_API_KEY=

# Analyse d'image generale multi-fournisseurs (Analyse photo : nourriture, peau,
# objet, produit, document, vetement, animal, plante, materiel AV). Actif des que
# l'une des cles ci-dessous est renseignee (OpenRouter essaye en premier, Gemini
# en secours - voir backend/src/config/aiProviders.js).
# OpenRouter (gratuit via le routeur openrouter/free) : cle sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
# GEMINI_API_KEY ci-dessus est reutilisee comme fournisseur de secours

# Coach IA texte : vrai LLM en priorite si au moins une cle ci-dessous est
# renseignee (Gemini reutilise GEMINI_API_KEY ci-dessus), sinon repli
# automatique sur le coach local (reflexif, regles, 0 euro).
# Mistral : cle gratuite sur https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Cohere : cle gratuite sur https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Z.AI (Zhipu) : cle sur https://open.bigmodel.cn
ZAI_API_KEY=

# Email du tout premier compte cree automatiquement en tant qu'administrateur
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
